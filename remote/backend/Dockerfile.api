FROM rust:1.97-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release --locked -p authorization-api --bin authorization-api --bin bootstrap-admin --bin migrate

FROM debian:bookworm-slim
COPY --from=build /src/target/release/authorization-api /usr/local/bin/authorization-api
COPY --from=build /src/target/release/bootstrap-admin /usr/local/bin/bootstrap-admin
COPY --from=build /src/target/release/migrate /usr/local/bin/migrate
USER 65532:65532
STOPSIGNAL SIGINT
ENTRYPOINT ["authorization-api"]
