# API
LISTEN_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://yoauthorize:change-me@postgres/yoauthorize
REDIS_URL=redis://redis:6379/
PUBLIC_URL=https://licenses.example.com
COOKIE_SECURE=true
ACTIVATION_PEPPER=replace-with-at-least-32-random-characters
SIGNER_URL=http://license-signer:8090
SIGNER_SHARED_SECRET=replace-with-at-least-32-random-characters
SMTP_URL=smtps://username:password@smtp.example.com:465
MAIL_FROM=YoAuthorize <licenses@example.com>

# Signer only. Mount this file read-only with mode 0400.
SIGNER_LISTEN_ADDR=0.0.0.0:8090
SIGNING_KEY_ID=production-2026-01
SIGNING_KEY_FILE=/run/secrets/license-signing-key

# One-shot bootstrap-admin CLI
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap-admin-password
