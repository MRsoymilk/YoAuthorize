YOAUTHORIZE_HTTP_PORT=8088
PUBLIC_URL=http://localhost:8088
COOKIE_SECURE=false
SIGNING_KEY_ID=development-1
SMTP_URL=smtp://yoauthorize-mailpit:1025
MAIL_FROM=YoAuthorize <no-reply@localhost>
LOCAL_UID=1000
LOCAL_GID=1000

# Linux only: use host for builds when Docker's configured proxy listens on loopback.
# DOCKER_BUILD_NETWORK=host

# Production example (use with compose.production.yaml):
# PUBLIC_URL=https://licenses.example.com
# COOKIE_SECURE=true
# SMTP_URL=smtps://username:password@smtp.example.com:465
# MAIL_FROM=YoAuthorize <licenses@example.com>
