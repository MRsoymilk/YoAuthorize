namespace yoauthorize.license;

enum LicenseType : byte {
  Trial = 0,
  Subscription = 1,
  Permanent = 2
}

enum MachineMode : byte {
  Unbound = 0,
  Exact = 1
}

table MachinePolicy {
  mode:MachineMode = Unbound;
  machine_id:string;
}

table LicensePayload {
  license_id:string;
  product_id:string;
  customer_id:string;
  issue_time:ulong;
  not_before:ulong;
  expire_time:ulong;
  license_type:LicenseType = Trial;
  features:[string];
  max_sessions:uint = 1;
  machine_policy:MachinePolicy;
}

table LicensePackage {
  format_version:ushort;
  key_id:string;
  payload:[ubyte];
  signature:[ubyte];
}

root_type LicensePackage;
file_identifier "YALC";
file_extension "yalc";
